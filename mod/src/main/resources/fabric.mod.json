{
  "schemaVersion": 1,
  "id": "minecraft_control",
  "version": "${version}",
  "name": "Minecraft Control",
  "description": "Local agent control of Minecraft gameplay and interfaces.",
  "environment": "client",
  "entrypoints": { "client": ["com.mizius.control.ControlMod"] },
  "mixins": ["minecraft-control.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_minimum}",
    "minecraft": ["${minecraft_versions}"],
    "java": ">=${java_version}"
  }
}
